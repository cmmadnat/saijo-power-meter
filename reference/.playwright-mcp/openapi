---
openapi: 3.0.3
info:
  title: field-reliability-app API
  version: 1.0.0
paths:
  /api/analytics/benchmark:
    get:
      tags:
      - Analytics Controller
      responses:
        "200":
          description: OK
        "403":
          description: Not Allowed
        "401":
          description: Not Authorized
      security:
      - SecurityScheme: []
  /api/analytics/predictions/{equipmentId}:
    get:
      tags:
      - Analytics Controller
      parameters:
      - name: equipmentId
        in: path
        required: true
        schema:
          type: string
      responses:
        "200":
          description: OK
        "403":
          description: Not Allowed
        "401":
          description: Not Authorized
      security:
      - SecurityScheme: []
  /api/analytics/reliability/{equipmentId}:
    get:
      tags:
      - Analytics Controller
      parameters:
      - name: equipmentId
        in: path
        required: true
        schema:
          type: string
      responses:
        "200":
          description: OK
        "403":
          description: Not Allowed
        "401":
          description: Not Authorized
      security:
      - SecurityScheme: []
  /api/analytics/reports:
    post:
      tags:
      - Analytics Controller
      requestBody:
        content:
          application/json:
            schema:
              type: object
              additionalProperties: {}
      responses:
        "200":
          description: OK
        "403":
          description: Not Allowed
        "401":
          description: Not Authorized
      security:
      - SecurityScheme: []
  /api/analytics/schedule-report:
    post:
      tags:
      - Analytics Controller
      requestBody:
        content:
          application/json:
            schema:
              type: object
              additionalProperties: {}
      responses:
        "200":
          description: OK
        "403":
          description: Not Allowed
        "401":
          description: Not Authorized
      security:
      - SecurityScheme: []
  /api/analytics/summary:
    get:
      tags:
      - Analytics Controller
      responses:
        "200":
          description: OK
        "403":
          description: Not Allowed
        "401":
          description: Not Authorized
      security:
      - SecurityScheme: []
  /api/analytics/trends/{equipmentId}:
    get:
      tags:
      - Analytics Controller
      parameters:
      - name: equipmentId
        in: path
        required: true
        schema:
          type: string
      - name: period
        in: query
        schema:
          format: int32
          default: 30
          type: integer
      responses:
        "200":
          description: OK
